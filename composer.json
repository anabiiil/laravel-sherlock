{
    "name": "anabiiil/laravel-sherlock",
    "description": "Laravel Sherlock: the detective that finds where your Laravel app is slow and why. Self-hosted performance diagnosis (slow queries, N+1, bottlenecks) with strict privacy.",
    "keywords": [
        "laravel",
        "sherlock",
        "performance",
        "tracing",
        "n-plus-one",
        "slow-query",
        "apm",
        "diagnosis"
    ],
    "homepage": "https://github.com/anabiiil/laravel-sherlock",
    "support": {
        "issues": "https://github.com/anabiiil/laravel-sherlock/issues",
        "source": "https://github.com/anabiiil/laravel-sherlock"
    },
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Anabil\\Sherlock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anabil\\Sherlock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Anabil\\Sherlock\\SherlockServiceProvider"
            ],
            "aliases": {
                "Sherlock": "Anabil\\Sherlock\\Facades\\Sherlock"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-apcu": "Shares the sherlock:watch window check between PHP-FPM workers (one cache read per 5s per server)"
    }
}
