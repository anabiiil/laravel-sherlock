includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Test helper trait: used by the application's test cases, never inside src.
        -
            identifier: trait.unused
            path: src/Testing/InteractsWithSherlock.php
